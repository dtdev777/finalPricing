# Copy to .env and replace every change_me value. Never commit .env.

# MongoDB (raw layer)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=pricing
MONGO_PASSWORD=change_me
MONGO_DB=pricing_raw

# PostgreSQL (clean and analytics layer)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pricing
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pricing

# Host ports for the web services
API_PORT=8000
DASHBOARD_PORT=8501

# Reference retailer and dashboard refresh interval
OWN_STORE=FPT Shop
DASHBOARD_REFRESH_SECONDS=60
